{
  "name": "dsh-her",
  "version": "0.1.0-dev.0",
  "description": "A desktop companion for DeepSeek Harness (dsh): she lives on your real desktop (on top of your windows or inside the wallpaper), talks with you by voice and remembers you. · DSH 桌面女友：住在你真正的桌面上，能语音聊天、记得你。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "companion",
    "desktop",
    "voice",
    "persona"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AIcivilization/dsh-her.git"
  },
  "homepage": "https://github.com/AIcivilization/dsh-her#readme",
  "author": "AIcivilization",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --disable-warning=ExperimentalWarning \"tests/*.test.ts\"",
    "voice:models": "node --disable-warning=ExperimentalWarning scripts/fetch-voice-models.ts",
    "voice:bench": "node --disable-warning=ExperimentalWarning scripts/voice-bench.ts",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dependencies": {
    "sherpa-onnx-node": "^1.12.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.12",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
