{
  "name": "dsh-her",
  "version": "0.8.0",
  "description": "A desktop companion for DeepSeek Harness (dsh): she lives on your real desktop (on top of your windows or inside the wallpaper), talks with you by voice and remembers you. · DSH 桌面女友：住在你真正的桌面上，能语音聊天、记得你。",
  "type": "module",
  "icon": "./lib/icon.png",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "companion",
    "desktop",
    "voice",
    "persona",
    "pet",
    "wallpaper",
    "skin",
    "theme",
    "appearance"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AIcivilization/dsh-her.git"
  },
  "homepage": "https://github.com/AIcivilization/dsh-her#readme",
  "author": "AIcivilization",
  "files": [
    "lib",
    "python",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.json && node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json",
    "test": "node --test --disable-warning=ExperimentalWarning \"tests/*.test.ts\"",
    "voice:models": "node --disable-warning=ExperimentalWarning scripts/fetch-voice-models.ts",
    "voice:bench": "node --disable-warning=ExperimentalWarning scripts/voice-bench.ts",
    "prepack": "npm run build && node --disable-warning=ExperimentalWarning scripts/make-icon.mjs && node scripts/embed-body-release.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dependencies": {
    "sherpa-onnx-node": "^1.12.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.12",
    "typescript": "^5.9.2",
    "@types/react": "^18.3.31",
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    },
    "catalog": {
      "category": "theme",
      "summary": {
        "en": "A desktop companion for DSH: she lives on your desktop, in the wallpaper or in dsh's own page, talks by voice, speaks first and remembers you.",
        "zh": "DSH 桌面女友：住在桌面上、壁纸里或 dsh 网页里，语音聊天，会先开口，记得你；形象和编排都能自己定。"
      },
      "capabilities": [
        "agents",
        "llm",
        "workspaces",
        "webServer",
        "sidebar",
        "desktopApp",
        "microphone",
        "speech",
        "network",
        "files"
      ]
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  }
}
